# Copy to .env (gitignored) for dev-mint.mjs, or set these in Vercel for production.
OPENAI_API_KEY=
# Shared key every app build sends as x-nerdy-key. At least 32 characters; generate with: openssl rand -hex 32
GUIDE_CLIENT_KEY=
# Optional budget overrides (per serverless instance).
SESSIONS_PER_MINUTE=6
SESSIONS_PER_DAY=200
